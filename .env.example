# PinPoint — configuración de despliegue. Copia a .env y ajusta.

# Puerto en el host (dentro del contenedor siempre es 8000)
PINPOINT_PORT=8096
PINPOINT_CONTAINER_NAME=pinpoint

# Carpeta de datos de trabajo en el host (fuentes registradas/subidas)
PINPOINT_DATA_HOST=./pinpoint-data

# Carpeta de vuelos del servidor (.bin + vídeos), montada en la MISMA ruta
# dentro del contenedor. Así el modo "Ruta en servidor" acepta rutas absolutas
# del host tal cual.
# OJO: se monta de LECTURA-ESCRITURA porque las subidas van a la biblioteca
# (PINPOINT_LIBRARY, que cuelga de aquí). La cuota es lo que acota el consumo.
PINPOINT_SOURCE_MOUNT=/mnt/data/srv/carto_private

# --- Biblioteca de vuelos ---
# Carpeta que la pantalla inicial lista en dos desplegables (vídeos y logs) y
# donde aterrizan las subidas. Tiene que estar DENTRO de PINPOINT_SOURCE_MOUNT.
PINPOINT_LIBRARY=/mnt/data/srv/carto_private/08_TEST/vueloFotogrametrico

# Tope de ocupación de esa carpeta, en GB. Al alcanzarlo se rechazan las
# subidas nuevas (nunca se borra nada solo).
PINPOINT_QUOTA_GB=25
